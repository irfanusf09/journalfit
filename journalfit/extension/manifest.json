{
  "manifest_version": 3,
  "name": "JournalFit",
  "version": "0.2.1",
  "description": "Fills journal submission forms from the package JournalFit prepared. You sign in, press Next and Submit yourself.",
  "permissions": ["activeTab", "scripting", "storage", "webNavigation"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.editorialmanager.com/*",
    "https://*.manuscriptcentral.com/*",
    "https://*.atyponrex.com/*",
    "https://authors.wiley.com/*",
    "https://*.scienceconnect.io/*",
    "https://*.springernature.com/*",
    "https://*.nature.com/*",
    "https://*.elsevier.com/*",
    "https://*.mdpi.com/*",
    "https://*.frontiersin.org/*",
    "https://*.tandfonline.com/*",
    "https://*.sagepub.com/*",
    "https://*.plos.org/*",
    "https://*.ieee.org/*",
    "https://*.acs.org/*",
    "https://*.rsc.org/*",
    "https://*.oup.com/*",
    "https://*.cambridge.org/*",
    "https://*.hindawi.com/*",
    "https://*.bmj.com/*",
    "https://*.copernicus.org/*",
    "https://*.emerald.com/*",
    "https://*.inderscience.com/*",
    "https://*.degruyter.com/*",
    "https://*.iop.org/*",
    "https://*.ejournalpress.com/*",
    "https://*.benchpress.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "JournalFit"},
  "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}
}
